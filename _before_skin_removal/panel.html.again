              </select>
              <select id="log-flt-source" onchange="renderLogs()">
                <option value="">全部来源</option>
                <option value="system">系统</option>
                <option value="plugin">插件</option>
                <option value="session">会话</option>
                <option value="inject">注入</option>
                <option value="panel">面板</option>
                <option value="user-action">用户操作</option>
              </select>
              <input id="log-flt-search" type="text" placeholder="关键字搜索…" oninput="renderLogs()">
              <button class="btn" onclick="exportLogs()">导出</button>
              <button class="btn" onclick="clearLogs()">清空</button>
