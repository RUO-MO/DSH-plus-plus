          <div>
            <div class="page-title">概览</div>
            <div class="page-sub">DeepSeek Harness 增强工作台 · 一切尽在此处</div>
          </div>
          <div class="page-actions">
            <button class="btn" id="btn-relaunch" style="display:none" onclick="confirmRestart()"></button>
            <button class="btn" onclick="runRepair()">自检修复</button>
            <button class="btn btn-solid" onclick="cdpApply()">立即注入</button>
          </div>
        </div>
        <div class="home-scroll" id="home-scroll">
          <div class="home-grid" id="home-grid"><!-- JS 渲染状态卡 --></div>
          <div class="home-sec-title">快捷操作</div>
          <div class="home-quick" id="home-quick"><!-- JS 渲染快捷操作 --></div>
          <div class="home-sec-title">最近动态</div>
          <div class="home-recent card" id="home-recent">—</div>
        </div>
      </div>

      <!-- ============ 分区：会话管理 ============ -->
      <div class="view" id="view-sessions" style="display:none;flex-direction:column;flex:1;min-height:0;">
        <div class="page-head">
          <div>
            <div class="page-title">会话管理</div>
            <div class="page-sub" id="sessions-sub">列出、导出与备份本机 DeepSeek Harness 会话</div>
          </div>
          <div class="page-actions">
            <input id="session-search" type="search" placeholder="跨会话全文搜索…" style="padding:6px 10px;border:1px solid var(--border-default);border-radius:6px;font-size:12px;width:220px" oninput="sessionSearchDebounced()">
            <button class="btn" onclick="compareSelected()">对比选中</button>
            <button class="btn" onclick="sessionDeleteSelected()">删除选中</button>
            <button class="btn" onclick="openDataDir('exports')">打开导出目录</button>
            <button class="btn" onclick="sessionsRefresh()">刷新</button>
            <button class="btn" onclick="sessionsBackupAll()">整库备份</button>
          </div>
        </div>
        <div id="session-search-result" style="display:none;max-height:38%;overflow:auto;border-bottom:1px solid var(--border-default)"></div>
        <div class="page-scroll" id="sessions-body"><div class="empty-hint">正在读取会话…</div></div>
      </div>

      <!-- ============ 分区：供应商配置 ============ -->
      <div class="view" id="view-prov" style="display:none;flex-direction:column;flex:1;min-height:0;">
        <div class="page-head">
          <div>
            <div class="page-title">供应商配置</div>
            <div class="page-sub">API Key 与模型路由 · 凭证备份与恢复（不改官方文件）</div>
          </div>
          <div class="page-actions">
            <button class="btn" onclick="openDataDir('backups')">打开备份目录</button>
            <button class="btn" onclick="provRefresh()">刷新</button>
