            <button class="btn" onclick="loadMarket()">刷新</button>
          </div>
        </div>
        <div class="page-scroll"><div class="market-grid" id="market-grid"><div class="empty-hint">正在加载…</div></div></div>
      </div>

      <!-- ============ 分区：插件管理 ============ -->
      <div class="view" id="view-plugins" style="display:none;flex-direction:column;flex:1;min-height:0;">
        <div class="page-head">
          <div>
            <div class="page-title">插件管理</div>
            <div class="page-sub" id="plugins-sub">npm 直装（A 轨）或装配行导入（B 轨）· 已发布 npm 的插件自动走官方 bundle 直装</div>
            <label class="plugin-master" title="关闭后所有插件注入立即失效（各插件开关状态保留，重开即恢复）">
              <span class="switch"><input type="checkbox" id="plugins-master" onchange="togglePluginAll(this.checked)"><span class="slider"></span></span>
              <span id="plugins-master-label">插件管理（总开关）</span>
            </label>
          </div>
          <div class="page-actions">
            <button class="btn" onclick="loadPlugins()">刷新</button>
            <input id="plugins-spec-input" class="plug-input" spellcheck="false"
                   placeholder="npm 包名 / @scope/包@版本 / github:user/repo#分支"
                   onkeydown="if(event.key==='Enter')installPluginSpec()" style="width:min(280px,38vw)">
            <button class="btn btn-solid" id="plugins-spec-btn" onclick="installPluginSpec()">安装</button>
            <button class="btn" id="plugins-install-btn" onclick="document.getElementById('plugins-file-input').click()">导入插件包</button>
            <button class="btn" id="plugins-dir-btn" onclick="document.getElementById('plugins-dir-input').click()">导入目录</button>
            <input type="file" id="plugins-file-input" accept=".zip,.tgz,.tar.gz" onchange="handlePluginInstall(event)" style="display:none">
            <input type="file" id="plugins-dir-input" webkitdirectory onchange="handlePluginDirInstall(event)" style="display:none">
          </div>
        </div>
        <div class="page-scroll">
          <div id="plugin-targets" style="font-size:12px;color:var(--text-secondary);margin-bottom:6px"></div>
          <div class="plugins-zone" id="plugins-zone">将 .zip / .tgz / .tar.gz 插件包拖到这里导入</div>
          <div class="plugins-grid" id="plugins-grid"><div class="empty-hint">正在加载…</div></div>
        </div>
      </div>

