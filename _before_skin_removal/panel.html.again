<!DOCTYPE html>
<html lang="zh-CN" data-page-node-id="stX2ESDfjsbGCxnasHPDKt">
<head data-page-node-id="tFASQbgPtrLKOGzUyS27Sc">
<meta charset="utf-8" data-page-node-id="AAjPcQEhngo7Fgjs4x9QEO">
<meta name="viewport" content="width=device-width, initial-scale=1" data-page-node-id="1mQYEfVHferKNNL6KyIgo2">
<title>DSH++ · 控制台</title>
<style>
/* ============================================================
   DSHSkin UI — design tokens
   Light  = [data-mode="light"]  (default)
   Dark   = [data-mode="dark"]
   强调色 #5E6BD1 严格锁定：主操作 / 选中态 / 焦点环，不做装饰。
   ============================================================ */
:root{
  --bg-app:#FAFAFA; --bg-surface:#FFFFFF; --bg-raised:#F5F5F5; --bg-hover:#F2F2F5;
  --border-default:#E0E0E5; --border-strong:#CFCFD6; --border-subtle:#EDEDF0;
  --text-primary:#17171C; --text-secondary:#52525C; --text-tertiary:#70707A; --text-disabled:#A1A1AB;
  --accent:#5E6BD1; --accent-hover:#5257C4; --accent-soft:#EDF0FA; --accent-text:#5257C4;
  --success:#1A8038; --success-soft:#E8F5ED;
  --danger:#C2382E; --danger-soft:#FAEDED;
  --warning:#996600; --warning-soft:#FFF8E6;
  --on-accent:#FFFFFF;
  --r-xs:4px; --r-sm:6px; --r-md:8px; --r-lg:10px;
  --sp1:4px; --sp2:8px; --sp3:12px; --sp4:16px; --sp5:20px; --sp6:24px;
  --rail-w:208px; --mono:'JetBrains Mono','Cascadia Mono',Consolas,ui-monospace,monospace;
  --sans:'Inter','Noto Sans SC','Microsoft YaHei',-apple-system,'Segoe UI',sans-serif;
  --hdr-h:48px;
}
[data-mode="dark"]{
  --bg-app:#0A0A0D; --bg-surface:#121217; --bg-raised:#1A1A1F; --bg-hover:#1F1F26;
  --border-default:#2B2B33; --border-strong:#3D3D45; --border-subtle:#212126;
  --text-primary:#F5F5F5; --text-secondary:#A1A1AB; --text-tertiary:#8C8C94; --text-disabled:#575761;
  --accent:#5E6BD1; --accent-hover:#6B78E3; --accent-soft:#1C1C33; --accent-text:#9CA3ED;
  --success:#40BA4F; --success-soft:#0F241A;
  --danger:#F26E6E; --danger-soft:#291417;
  --warning:#D19921; --warning-soft:#2A2110;
}

*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background:var(--bg-app); color:var(--text-primary);
  font-family:var(--sans); font-size:12px; line-height:1.5;
  -webkit-font-smoothing:antialiased; overflow:hidden;
}
button,input,textarea,select{font:inherit;color:inherit}
::selection{background:var(--accent);color:var(--on-accent)}

/* 滚动条 —— 工具风，不抢眼 */
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:5px;border:3px solid transparent;background-clip:padding-box}
::-webkit-scrollbar-thumb:hover{background:var(--text-disabled);border:3px solid transparent;background-clip:padding-box}

/* ============================ 应用外壳 ============================ */
.app{height:100vh;display:flex;flex-direction:column;background:var(--bg-app)}

/* ---- 顶栏 ---- */
.header{
  height:var(--hdr-h); flex:0 0 var(--hdr-h);
  display:flex; align-items:center; gap:var(--sp3);
  padding:0 var(--sp4);
}
.brand{display:flex;align-items:center;gap:8px}
.brand-mark{
  width:22px;height:22px;border-radius:5px;background:var(--accent);
  display:flex;align-items:center;justify-content:center;color:#fff;flex:0 0 22px;
}
.brand-mark svg{width:13px;height:13px}
.brand-text h1{font-size:14px;font-weight:600;letter-spacing:-.01em;line-height:1.2}
.brand-text p{display:none}
.header .spacer{flex:1}

.search-wrap{position:relative;width:240px}
.search-box{
  width:100%;height:30px;border-radius:var(--r-sm);
  background:var(--bg-raised);border:1px solid transparent;
  padding:0 56px 0 30px;font-size:12px;outline:none;
}
.search-box::placeholder{color:var(--text-tertiary)}
.search-box:focus{border-color:var(--accent);background:var(--bg-surface)}
.search-wrap .s-ico{
  position:absolute;left:9px;top:50%;transform:translateY(-50%);
  width:13px;height:13px;color:var(--text-tertiary);pointer-events:none;
}
.search-wrap .s-kbd{
  position:absolute;right:8px;top:50%;transform:translateY(-50%);
  font-family:var(--mono);font-size:9.5px;color:var(--text-tertiary);
  background:var(--bg-surface);border:1px solid var(--border-subtle);
  border-radius:var(--r-xs);padding:2px 5px;pointer-events:none;
}

.health-badge{
  display:flex;align-items:center;gap:6px;cursor:pointer;user-select:none;
  background:var(--success-soft);border-radius:5px;padding:5px 9px;
  transition:filter .12s;
}
.health-badge:hover{filter:brightness(.97)}
.health-badge.bad{background:var(--danger-soft)}
.health-badge.warn{background:var(--warning-soft)}
.health-dot{width:6px;height:6px;border-radius:50%;background:var(--success);flex:0 0 6px}
.health-badge.bad .health-dot{background:var(--danger)}
.health-badge.warn .health-dot{background:var(--warning)}
.health-text{font-size:11px;font-weight:500;color:var(--text-primary);white-space:nowrap}

/* 明暗分段控件 */
.seg{
  display:flex;align-items:center;gap:2px;background:var(--bg-raised);
  border-radius:var(--r-sm);padding:2px;
}
.seg button{
  border:none;background:transparent;cursor:pointer;
  font-size:11px;color:var(--text-tertiary);
  padding:4px 10px;border-radius:var(--r-xs);white-space:nowrap;
}
.seg button.on{background:var(--bg-surface);color:var(--text-primary);font-weight:500}

/* ---- 通用按钮 ---- */
.btn{
  display:inline-flex;align-items:center;gap:6px;cursor:pointer;
  border-radius:var(--r-sm);padding:6px 12px;font-size:12px;
  border:1px solid var(--border-strong);background:transparent;
  color:var(--text-secondary);transition:background .12s,color .12s;white-space:nowrap;
}
.btn:hover{background:var(--bg-hover);color:var(--text-primary)}
.btn svg{width:12px;height:12px;flex:0 0 12px}
.btn-solid{
  background:var(--accent);border-color:var(--accent);color:var(--on-accent);font-weight:500;
}
.btn-solid:hover{background:var(--accent-hover);border-color:var(--accent-hover);color:var(--on-accent)}
.btn-ghost{border-color:transparent}
.btn-ghost:hover{background:var(--bg-hover)}
.btn:disabled{opacity:.45;cursor:not-allowed}

/* 发丝线 */
.hairline{height:1px;flex:0 0 1px;background:var(--border-default)}
.vhairline{width:1px;flex:0 0 1px;background:var(--border-default)}

/* 重启提示条 */
.restart-bar{
  display:none;align-items:center;gap:var(--sp3);
  padding:8px var(--sp4);flex:0 0 auto;
  background:var(--warning-soft);border-bottom:1px solid var(--border-subtle);
}
.restart-bar.show{display:flex}
.rb-left{display:flex;align-items:center;gap:8px;flex:1}
.rb-left .health-dot{background:var(--warning)}
#restart-text{font-size:11.5px;color:var(--text-primary)}
.rb-actions{display:flex;gap:8px}

/* 后端离线提示（固定底部，避免被视图遮挡） */
.backend-offline-bar{
  display:none;position:fixed;left:50%;bottom:20px;transform:translateX(-50%);
  align-items:center;gap:12px;z-index:200;
  padding:10px 16px;max-width:calc(100vw - 40px);
  background:var(--danger-soft, #fdecec);border:1px solid var(--danger, #d64545);
  border-radius:10px;box-shadow:0 6px 24px rgba(0,0,0,.14);
  font-size:12px;color:var(--text-primary);
}
.backend-offline-bar.show{display:flex}
.backend-offline-bar span{flex:1;min-width:0}

/* ============================ 主体 ============================ */
.body{flex:1;display:flex;min-height:0}

/* ---- 左栏 ---- */
.rail{
  width:var(--rail-w);flex:0 0 var(--rail-w);
  display:flex;flex-direction:column;gap:2px;
  padding:var(--sp3) 10px 10px;
}
.rail-group{font-size:11px;font-weight:500;color:var(--text-tertiary);padding:8px 8px 5px;letter-spacing:.02em}
.nav{
  display:flex;align-items:center;gap:9px;cursor:pointer;
  padding:7px 9px;border-radius:var(--r-sm);user-select:none;
}
.nav:hover{background:var(--bg-hover)}
.nav svg{width:14px;height:14px;flex:0 0 14px;color:var(--text-secondary)}
.nav-label{flex:1;font-size:12.5px;color:var(--text-secondary)}
.nav-count{font-family:var(--mono);font-size:10.5px;color:var(--text-tertiary)}
.nav.on{background:var(--accent-soft)}
.nav.drift-alert{position:relative}
.nav.drift-alert::after{content:'';position:absolute;right:8px;top:50%;transform:translateY(-50%);width:7px;height:7px;border-radius:50%;background:var(--danger);box-shadow:0 0 0 2px var(--bg-app)}
.nav.on svg{color:var(--accent)}
.nav.on .nav-label{color:var(--accent-text);font-weight:500}
.nav.on .nav-count{color:var(--accent-text)}
.nav-count.alert{color:var(--danger)}
.rail-divider{padding:6px 8px}
.rail-divider .ln{height:1px;background:var(--border-subtle)}
.rail-spacer{flex:1}

/* 宿主状态卡 */
.host-card{
  background:var(--bg-surface);border:1px solid var(--border-default);
  border-radius:var(--r-md);padding:11px 12px;display:flex;flex-direction:column;gap:8px;
}
.host-row{display:flex;align-items:center;gap:7px}
.host-row .health-dot{background:var(--success)}
.host-row.off .health-dot{background:var(--text-disabled)}
.host-name{font-size:11.5px;font-weight:500;color:var(--text-primary)}
.host-meta{font-size:9.5px;font-family:var(--mono);color:var(--text-tertiary);line-height:1.6}
.host-btn{
  display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;
  background:var(--bg-raised);border:none;border-radius:var(--r-sm);
  padding:6px;font-size:11px;color:var(--text-secondary);
}
.host-btn:hover{background:var(--bg-hover);color:var(--text-primary)}
.host-btn svg{width:11px;height:11px;flex:0 0 11px}

/* ---- 主区 ---- */
.main{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0}

.page-head{
  display:flex;align-items:flex-end;justify-content:space-between;gap:var(--sp4);
  padding:var(--sp5) var(--sp6) 0;
}
.page-title{font-size:16px;font-weight:600;letter-spacing:-.01em}
.page-sub{font-size:12px;color:var(--text-tertiary);margin-top:5px}
.page-actions{display:flex;gap:8px;align-items:center}

.toolbar{
  display:flex;align-items:center;gap:7px;
  padding:var(--sp4) var(--sp6) var(--sp3);flex-wrap:wrap;
}
.chip{
  font-size:11.5px;padding:5px 11px;border-radius:14px;cursor:pointer;
  background:var(--bg-raised);color:var(--text-secondary);border:none;user-select:none;
}
.chip:hover{background:var(--bg-hover);color:var(--text-primary)}
.chip.on{background:var(--accent-soft);color:var(--accent-text);font-weight:500}
.toolbar .spacer{flex:1;min-width:12px}
.switch-wrap{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none}
.switch-wrap .sw-label{font-size:11px;color:var(--text-tertiary)}

/* ---- 内容：列表 + 检查器 ---- */
.content{flex:1;display:flex;min-height:0;padding:0 var(--sp6) var(--sp4)}

.list-pane{
  width:400px;flex:0 0 400px;display:flex;flex-direction:column;
  background:var(--bg-surface);border:1px solid var(--border-default);border-right:none;
  border-radius:var(--r-md) 0 0 var(--r-md);overflow:hidden;
}
.list-scroll{flex:1;overflow-y:auto;overflow-x:hidden}

.trow{
  display:flex;align-items:center;gap:10px;cursor:pointer;
  padding:8px 13px;border-bottom:1px solid var(--border-subtle);
}
.trow:hover{background:var(--bg-hover)}
.trow.on{background:var(--accent-soft)}
.trow.on:hover{background:var(--accent-soft)}
.trow-swatch{
  width:32px;height:32px;border-radius:var(--r-sm);flex:0 0 32px;
  border:1px solid var(--border-default);background:var(--bg-raised);
  /* 主题壁纸的主体不在正中：实测两张壁纸的视觉重心分别在 78% / 66%，
     取 72% 能同时框住主体；用 center 只会裁到一片留白。 */
  background-size:cover;background-position:72% center;
}
.trow-text{flex:1;min-width:0}
.trow-name{
  font-size:12.5px;font-weight:500;color:var(--text-primary);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.trow-meta{
  font-size:10.5px;color:var(--text-tertiary);margin-top:2px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.trow-badge{
  flex:0 0 auto;background:var(--accent);color:var(--on-accent);
  font-size:9.5px;font-weight:500;border-radius:var(--r-xs);padding:2.5px 7px;
}
.trow-size{
  flex:0 0 auto;font-family:var(--mono);font-size:10.5px;
  color:var(--text-tertiary);padding-left:6px;
}
.list-foot{
  flex:0 0 auto;border-top:1px solid var(--border-subtle);
  padding:9px 13px;font-size:10.5px;color:var(--text-tertiary);
}
.list-empty{padding:32px 16px;text-align:center;color:var(--text-tertiary);font-size:11.5px}

/* 检查器 */
.inspector{
  flex:1;min-width:0;display:flex;flex-direction:column;overflow:hidden;
  background:var(--bg-surface);border:1px solid var(--border-default);
  border-radius:0 var(--r-md) var(--r-md) 0;
}
.insp-preview{
  height:148px;flex:0 0 148px;position:relative;overflow:hidden;
  background:var(--bg-raised);display:flex;align-items:flex-end;padding:14px;
}
.insp-preview .pv-img{
  position:absolute;inset:0;background-size:cover;background-position:center;
}
.insp-preview .pv-grad{position:absolute;inset:0}
.insp-preview .pv-grad::after{
  content:'';position:absolute;inset:0;
  /* 左侧压一层到透明的暗角，保证调色板与白色壁纸的留白区都有对比 */
  background:linear-gradient(to right,rgba(0,0,0,.34) 0%,rgba(0,0,0,.12) 38%,transparent 62%),
             linear-gradient(to top,rgba(0,0,0,.30),transparent 52%);
}
.palette{display:flex;gap:7px;position:relative;z-index:1}
.palette i{
  width:30px;height:15px;border-radius:3px;display:block;
  /* 用中性发丝线而不是白描边——白描边在白色壁纸上会整片消失 */
  border:1px solid rgba(0,0,0,.28);
  box-shadow:0 0 0 1px rgba(255,255,255,.35) inset;
}
.insp-body{
  flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:var(--sp4);
  padding:14px 16px;
}
.insp-empty{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:8px;color:var(--text-tertiary);font-size:11.5px;padding:40px 16px;text-align:center;
}
.insp-head{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--sp3)}
.insp-name{font-size:14px;font-weight:600}
.insp-meta{font-size:10.5px;color:var(--text-tertiary);margin-top:3px;line-height:1.6}
.insp-acts{display:flex;gap:6px;align-items:center;flex:0 0 auto}
.mini{
  display:inline-flex;align-items:center;gap:5px;cursor:pointer;white-space:nowrap;
  font-size:11.5px;border-radius:5px;padding:5px 10px;
  border:1px solid var(--border-strong);background:transparent;color:var(--text-secondary);
}
.mini:hover{background:var(--bg-hover);color:var(--text-primary)}
.mini.prim{background:var(--accent);border-color:var(--accent);color:var(--on-accent);font-weight:500}
.mini.prim:hover{background:var(--accent-hover);border-color:var(--accent-hover)}
.mini.icon{padding:5px 8px}
.mini svg{width:12px;height:12px;flex:0 0 12px}

.sec-label{
  font-size:10.5px;font-weight:500;color:var(--text-secondary);
  letter-spacing:.02em;margin-bottom:8px;
}
.sec-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.sec-head .sec-label{margin-bottom:0}
.sec-note{font-size:10.5px;color:var(--accent-text);font-weight:500}
.sec-note.bad{color:var(--danger)}

/* 参数栅格（3 列紧凑） */
.param-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.param-cell{background:var(--bg-raised);border-radius:var(--r-sm);padding:8px 10px;min-width:0}
.param-cell .k{font-size:10.5px;color:var(--text-tertiary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.param-cell .v{
  font-family:var(--mono);font-size:12px;font-weight:500;color:var(--text-primary);
  margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

.region-wrap{display:flex;flex-wrap:wrap;gap:6px}
.region-chip{
  background:var(--bg-raised);border-radius:5px;padding:4px 9px;
  font-size:10.5px;color:var(--text-secondary);white-space:nowrap;
}
.region-chip.off{color:var(--text-disabled);text-decoration:line-through}

.kv-row{display:flex;align-items:flex-start;gap:14px;padding:4px 0}
.kv-row .k{font-size:11px;color:var(--text-tertiary);flex:0 0 84px}
.kv-row .v{font-size:11px;color:var(--text-secondary);min-width:0;word-break:break-all}
.kv-row .v.mono{font-family:var(--mono)}
.insp-foot{
  flex:0 0 auto;display:flex;align-items:center;gap:8px;
  padding:12px 16px;border-top:1px solid var(--border-subtle);
}
.insp-foot .del{margin-left:auto;font-size:11.5px;color:var(--danger);font-weight:500;cursor:pointer}
.insp-foot .del:hover{text-decoration:underline}

/* ============================ 开关 ============================ */
.switch{position:relative;display:inline-block;width:26px;height:15px;flex:0 0 26px}
.switch input{opacity:0;width:0;height:0}
.slider{
  position:absolute;inset:0;cursor:pointer;border-radius:8px;
  background:var(--border-strong);transition:background .15s;
}
.slider:before{
  content:'';position:absolute;height:11px;width:11px;left:2px;top:2px;
  background:#fff;border-radius:50%;transition:transform .15s;
}
.switch input:checked + .slider{background:var(--accent)}
.switch input:checked + .slider:before{transform:translateX(11px)}

/* ============================ 增强器分区 ============================ */
.enh-master{
  display:flex;align-items:center;gap:10px;background:var(--bg-raised);
  border-radius:var(--r-sm);padding:10px 12px;margin-bottom:10px;
}
.enh-master-text{flex:1;min-width:0}
.enh-name{font-size:12px;font-weight:500}
.enh-desc{font-size:10.5px;color:var(--text-tertiary);margin-top:2px}
.enh-modules{display:flex;flex-direction:column;gap:1px}
.enh-mod{
  display:flex;align-items:center;gap:10px;padding:8px 10px;
  border-radius:var(--r-sm);cursor:default;
}
.enh-mod:hover{background:var(--bg-hover)}
.enh-mtext{flex:1;min-width:0}
.enh-mname{font-size:11.5px;font-weight:500;display:flex;align-items:center;gap:6px}
.enh-mdesc{font-size:10.5px;color:var(--text-tertiary);margin-top:2px}
.enh-meta{font-size:9.5px;font-family:var(--mono);color:var(--text-disabled)}
.enh-badge{
  font-size:9px;font-weight:500;background:var(--accent-soft);color:var(--accent-text);
  border-radius:3px;padding:1.5px 5px;
}
.enh-script{
  display:flex;align-items:center;gap:9px;padding:7px 10px;
  border-radius:var(--r-sm);cursor:pointer;
}
.enh-script:hover{background:var(--bg-hover)}
.enh-fname{flex:1;font-family:var(--mono);font-size:11px;color:var(--text-primary);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.enh-icon-btn{
  border:none;background:transparent;cursor:pointer;color:var(--text-tertiary);
  padding:3px;border-radius:var(--r-xs);display:flex;
}
.enh-icon-btn:hover{background:var(--bg-raised);color:var(--text-primary)}
.enh-icon-btn svg{width:12px;height:12px}
.enh-empty, .load-error{padding:14px 10px;font-size:11px;color:var(--text-tertiary);text-align:center}
.load-error{color:var(--danger)}

/* 通用动作行 */
.action-list{display:flex;flex-direction:column;gap:2px}
.action-item{
  display:flex;align-items:center;gap:10px;padding:8px 10px;
  border-radius:var(--r-sm);cursor:pointer;
}
.action-item:hover{background:var(--bg-hover)}
.action-icon{
  width:26px;height:26px;flex:0 0 26px;border-radius:var(--r-sm);
  background:var(--bg-raised);display:flex;align-items:center;justify-content:center;
  color:var(--text-secondary);
}
.action-item:hover .action-icon{background:var(--bg-surface);color:var(--text-primary)}
.action-icon svg{width:13px;height:13px}
.action-text{font-size:11.5px;font-weight:500;color:var(--text-primary)}
.action-desc{font-size:10.5px;color:var(--text-tertiary);margin-top:1px}

/* 卡片 / 分区容器 */
.card{
  background:var(--bg-surface);border:1px solid var(--border-default);
  border-radius:var(--r-md);padding:14px 16px;
}
.card + .card{margin-top:12px}
.card-title{
  font-size:10.5px;font-weight:500;color:var(--text-secondary);
  letter-spacing:.02em;margin-bottom:10px;
}

/* 参数控件（编辑器左栏） */
.editor-controls{display:flex;flex-direction:column;gap:14px}
.param-group{display:flex;flex-direction:column;gap:7px}
.param-label{font-size:11px;color:var(--text-secondary);font-weight:500}
.param-range{width:100%;height:3px;-webkit-appearance:none;appearance:none;
  background:var(--border-strong);border-radius:2px;outline:none}
.param-range::-webkit-slider-thumb{
  -webkit-appearance:none;width:13px;height:13px;border-radius:50%;
  background:var(--accent);cursor:pointer;border:2px solid var(--bg-surface);box-shadow:0 0 0 1px var(--accent);
}
.param-value{font-family:var(--mono);font-size:11px;color:var(--text-tertiary)}
.param-color{display:flex;gap:6px;flex-wrap:wrap}
.param-color button{
  width:22px;height:22px;border-radius:var(--r-xs);cursor:pointer;
  border:2px solid transparent;padding:0;
}
.param-color button.on{border-color:var(--accent)}

/* 日志 */
.log-content{display:flex;flex-direction:column;gap:1px;max-height:420px;overflow-y:auto}
.log-entry{
  display:flex;gap:12px;padding:7px 10px;border-radius:var(--r-sm);font-size:11px;
}
.log-entry:hover{background:var(--bg-hover)}
.log-time{font-family:var(--mono);font-size:10px;color:var(--text-disabled);flex:0 0 auto}
.log-msg.error{color:var(--danger,#d64541)}
.log-msg.warn{color:var(--warn,#d8a13a)}
.log-msg.success{color:var(--success,#2f9e62)}
.log-toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.log-toolbar select,.log-toolbar input{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:6px;color:var(--text-primary);padding:5px 8px;font-size:12px}
.log-toolbar input{flex:1;min-width:140px}

/* ============================ 模态 ============================ */
.modal-overlay{
  position:fixed;inset:0;background:rgba(10,10,13,.5);
  display:none;align-items:center;justify-content:center;z-index:100;padding:24px;
  backdrop-filter:blur(2px);
}
.modal-overlay.show{display:flex}
.modal{
  background:var(--bg-surface);border:1px solid var(--border-default);
  border-radius:var(--r-lg);padding:20px;width:min(460px,100%);
  box-shadow:0 16px 48px rgba(0,0,0,.24);
}
.modal h3{font-size:14px;font-weight:600;margin-bottom:8px}
.modal p{font-size:12px;color:var(--text-secondary);line-height:1.6;margin-bottom:18px;max-height:64vh;overflow-y:auto;overflow-x:hidden}
.modal-actions{display:flex;justify-content:flex-end;gap:8px}

/* ===================== 会话详情分页页 ===================== */
.conv-page{
  position:fixed;top:0;left:0;right:0;bottom:0;background:var(--bg-surface);z-index:120;
  display:none;flex-direction:column;
}
.conv-page.show{display:flex}
.conv-head{display:flex;align-items:flex-start;gap:12px;padding:16px 24px;border-bottom:1px solid var(--border-default)}
.conv-head .titles{flex:1;min-width:0}
.conv-head h3{margin:0;font-size:15px;font-weight:600;color:var(--text-primary);word-break:break-word}
.conv-head .meta{font-size:11px;color:var(--text-secondary);margin-top:4px;line-height:1.6}
.conv-body{
  flex:1;min-height:0;overflow:auto;padding:20px 28px;white-space:pre-wrap;
  font-size:12.5px;line-height:1.8;color:var(--text-primary);word-break:break-word;
}
.conv-foot{display:flex;align-items:center;justify-content:center;gap:14px;padding:10px 16px;border-top:1px solid var(--border-default);font-size:12px;color:var(--text-secondary)}
.conv-foot .btn:disabled{opacity:.4;cursor:not-allowed}

/* 脚本编辑器 */
.enh-editor{width:min(720px,100%)}
.enh-tip{
  font-size:11px;color:var(--text-secondary);line-height:1.65;
  background:var(--bg-raised);border-radius:var(--r-sm);padding:10px 12px;margin-bottom:14px;
}
.enh-tip code{
  font-family:var(--mono);font-size:10.5px;background:var(--bg-surface);
  border:1px solid var(--border-subtle);border-radius:3px;padding:1px 4px;
}
.enh-field{margin-bottom:10px}
.enh-field input{
  width:100%;height:32px;border-radius:var(--r-sm);border:1px solid var(--border-strong);
  background:var(--bg-app);padding:0 11px;font-family:var(--mono);font-size:11.5px;outline:none;
}
.enh-field input:focus{border-color:var(--accent)}
#enh-code{
  width:100%;height:300px;border-radius:var(--r-sm);border:1px solid var(--border-strong);
  background:var(--bg-app);padding:12px;resize:vertical;outline:none;
  font-family:var(--mono);font-size:11.5px;line-height:1.65;
}
#enh-code:focus{border-color:var(--accent)}

/* ============================ 调参编辑器弹层 ============================ */
.editor-panel{
  background:var(--bg-surface);border:1px solid var(--border-default);
  border-radius:var(--r-lg);width:min(1180px,100%);max-height:calc(100vh - 48px);
  display:flex;flex-direction:column;overflow:hidden;
  box-shadow:0 24px 64px rgba(0,0,0,.3);
}
.editor-head{
  display:flex;align-items:flex-start;justify-content:space-between;gap:16px;
  padding:18px 22px 16px;border-bottom:1px solid var(--border-subtle);flex:0 0 auto;
}
.editor-head h3{font-size:14px;font-weight:600}
.editor-head h3 span{color:var(--accent-text);font-weight:500}
.editor-sub{font-size:11px;color:var(--text-tertiary);margin-top:5px;line-height:1.6}
.editor-body{flex:1;display:flex;min-height:0}
.editor-controls{
  width:300px;flex:0 0 300px;overflow-y:auto;
  padding:16px 18px;border-right:1px solid var(--border-subtle);
}
.editor-preview{flex:1;min-width:0;display:flex;flex-direction:column;background:var(--bg-app)}

/* 保真声明（红线提示） */
.fidelity-note{
  display:flex;align-items:flex-start;gap:8px;flex:0 0 auto;
  padding:10px 18px;background:var(--accent-soft);
  border-bottom:1px solid var(--border-subtle);
  font-size:11px;color:var(--accent-text);line-height:1.6;
}
.fidelity-note svg{width:13px;height:13px;flex:0 0 13px;margin-top:2px}

/* 模拟器工具条 */
.sim-controls{
  display:flex;align-items:center;gap:16px;flex-wrap:wrap;flex:0 0 auto;
  padding:10px 18px;border-bottom:1px solid var(--border-subtle);
}
.sim-ctrl-group{display:flex;align-items:center;gap:4px}
.sim-ctrl-label{font-size:10.5px;color:var(--text-tertiary);margin-right:3px}
.sim-ctrl-btn{
  border:1px solid transparent;background:transparent;cursor:pointer;
  font-size:10.5px;color:var(--text-secondary);
  padding:3px 8px;border-radius:var(--r-xs);
}
.sim-ctrl-btn:hover{background:var(--bg-hover);color:var(--text-primary)}
.sim-ctrl-btn.on{background:var(--bg-surface);border-color:var(--border-default);color:var(--text-primary);font-weight:500}

/* 预览舞台 */
.preview-stage{
  flex:1;min-height:0;overflow:auto;padding:18px;
  display:flex;align-items:flex-start;justify-content:center;
}
.editor-foot{
  display:flex;align-items:center;gap:12px;flex:0 0 auto;
  padding:14px 22px;border-top:1px solid var(--border-subtle);
}
.editor-version{font-family:var(--mono);font-size:10.5px;color:var(--text-disabled)}

/* 预览回退态 */
.preview-fallback{
  display:flex;align-items:center;justify-content:center;
  min-height:120px;color:var(--text-tertiary);font-size:11.5px;text-align:center;padding:20px;
}

/* ============================================================
   ★ 保真窗口 —— 不得改动其内部结构 / 类名 / 尺寸
   仅允许通过主题变量着色。此块由注入的主题 CSS 驱动。
   ============================================================ */

/* ============================================================
   ★★ 保真窗口样式 —— 以下全部保留自 DeepSeek Harness 1:1 还原
   结构 / 类名 / 尺寸不得改动，仅由主题变量着色
   ============================================================ */
      /* 保真窗口的颜色由「被预览主题」决定，与 DSHSkin 设计系统解耦。
         色值对齐 DeepSeek Harness + 雨林苔痕主题，代表真实应用外观。 */
      .sim-window{
        --sim-tx-1:#e8eee9; --sim-tx-2:#9fb0a5; --sim-tx-3:#6f8279;
        --sim-accent:#6b8c61; --sim-accent-deep:#426b51;
        --sim-line:rgba(255,255,255,.10); --sim-line-strong:rgba(255,255,255,.18);
        --sim-warn:#d9a657;
      }
  /* 作用域容器：等价于真实应用里的 dsh-app 根节点 */
  .sim-window {
    width: 100%;
    max-width: 560px;
    min-height: 620px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow: 0 18px 50px rgba(38, 34, 28, 0.3);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    background-color: #faf6f0;
    transition: max-width 0.25s ease;
  }
  .sim-window.narrow { max-width: 372px; }
  /* 模拟器控制条（仿 DreamSkin：页面/窗口/侧栏/外观） */
  .sim-menubar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 5px 12px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(10px);
    font-size: 10.5px;
    color: var(--sim-tx-2);
    flex-shrink: 0;
    border-bottom: 1px solid rgba(38, 34, 28, 0.07);
  }
  .sim-menubar .sim-win-controls {
    margin-left: auto;
    display: flex;
    gap: 10px;
    color: var(--sim-tx-3);
    font-family: var(--mono);
    font-size: 10px;
  }
  .sim-body { flex: 1; display: flex; min-height: 0; }
  .sim-sidebar {
    width: 132px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    padding: 12px 8px;
    gap: 8px;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(12px);
    border-right: 1px solid rgba(38, 34, 28, 0.07);
    overflow: hidden;
    transition: display 0s;
  }
  .sim-sidebar.hidden { display: none; }
  .sim-nav { display: flex; flex-direction: column; gap: 2px; }
  .sim-nav-item {
    font-size: 10.5px;
    padding: 4px 8px;
    border-radius: 6px;
    color: var(--sim-tx-2);
    white-space: nowrap;
    overflow: hidden;
  }
  .sim-nav-item.on { background: rgba(60, 90, 74, 0.14); color: var(--sim-accent-deep); font-weight: 700; }
  .sim-newtask {
    font-size: 10.5px;
    padding: 5px 8px;
    border-radius: 6px;
    background: var(--sim-accent);
    color: #f7f3ea;
    text-align: center;
    cursor: pointer;
    white-space: nowrap;
  }
  .sim-menus { display: flex; flex-direction: column; gap: 2px; border-top: 1px solid rgba(38, 34, 28, 0.08); padding-top: 6px; }
  .sim-menu-item {
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 5px;
    color: var(--sim-tx-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sim-tasklist { flex: 1; display: flex; flex-direction: column; gap: 2px; overflow: hidden; border-top: 1px solid rgba(38, 34, 28, 0.08); padding-top: 6px; }
  .sim-task-head { font-size: 9px; color: var(--sim-tx-3); padding: 2px 8px 4px; }
  .sim-task {
    font-size: 9.5px;
    padding: 3px 7px;
    border-radius: 5px;
    color: var(--sim-tx-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sim-task.on { background: rgba(168, 131, 90, 0.18); color: var(--sim-warn); font-weight: 600; }
  .sim-login {
    font-size: 10px;
    color: var(--sim-accent-deep);
    padding: 5px 7px;
    border-top: 1px solid rgba(38, 34, 28, 0.08);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sim-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .sim-topbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 14px;
    border-bottom: 1px solid rgba(38, 34, 28, 0.08);
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(10px);
    font-size: 12.5px;
    font-weight: 600;
    flex-shrink: 0;
  }
  .sim-dot { width: 8px; height: 8px; border-radius: 50%; background: #d8d2c6; flex-shrink: 0; }
  .sim-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sim-tag {
    font-size: 10px; font-weight: 500; color: var(--sim-tx-2);
    border: 1px solid var(--sim-line); border-radius: 999px; padding: 2px 9px;
    white-space: nowrap;
  }
  /* 会话区：真实类名容器（.chat-viewpane > .interactive-session > .interactive-list） */
  .sim-chat {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 16px 12px;
  }
  /* 消息项 = 真实 .interactive-item-container（玻璃/圆角由注入 CSS 命中） */
  .sim-msg-row { display: flex; gap: 10px; max-width: 94%; }
  .sim-msg-row.user { align-self: flex-end; flex-direction: row-reverse; }
  .sim-avatar {
    width: 26px; height: 26px; border-radius: 8px; flex-shrink: 0;
    background: linear-gradient(135deg, #b99a74, #8c6c47);
    color: #fdf8ee; display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700; margin-top: 2px;
  }
  .sim-msg-row.user .sim-avatar { background: linear-gradient(135deg, var(--sim-accent), var(--sim-accent-deep)); }
  .sim-msg-body { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .sim-msg-row.user .sim-msg-body { align-items: flex-end; }
  .sim-msg-head { display: flex; gap: 8px; align-items: baseline; font-size: 10.5px; color: var(--sim-tx-2); }
  .sim-msg-head .sim-author { font-weight: 600; color: var(--sim-tx-1); }
  .sim-msg-head .sim-time { font-family: var(--mono); font-size: 9.5px; }
  .sim-msg {
    padding: 10px 13px;
    font-size: 12px;
    line-height: 1.65;
    color: var(--sim-tx-1);
    white-space: pre-line;
  }
  .sim-msg.ai { border-top-left-radius: 4px; }
  .sim-msg.user { border-top-right-radius: 4px; }
  .sim-code {
    margin-top: 8px;
    background: rgba(38, 34, 28, 0.85);
    color: #e8e2d4;
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.6;
    border-radius: 8px;
    padding: 9px 11px;
    white-space: pre;
    overflow-x: auto;
  }
  /* 输入框 = 真实 .interactive-input-part 结构（磨砂+光晕由注入 CSS 命中） */
  .sim-inputbar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 16px 16px;
    padding: 9px 12px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.66);
    backdrop-filter: blur(22px) saturate(1.2);
    flex-shrink: 0;
  }
  .sim-plus {
    width: 22px; height: 22px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    color: var(--sim-tx-2); font-size: 15px; font-weight: 400;
  }
  .sim-input {
    flex: 1;
    font-size: 12.5px;
    color: var(--sim-tx-2);
    background: transparent;
    border: none;
    outline: none;
    min-width: 0;
  }
  .sim-send {
    width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
    background: var(--sim-accent); color: #f7f3ea;
    display: flex; align-items: center; justify-content: center;
  }
  .sim-send svg { width: 12px; height: 12px; }

  /* ---- 首页（新对话）视图 = 真实 .chat-welcome-view-container ---- */
  .sim-home {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 18px 26px;
    text-align: center;
    overflow-y: auto;
  }
  .sim-home-logo {
    width: 46px; height: 46px;
    border-radius: 12px;
    background: linear-gradient(135deg, #b99a74, #8c6c47);
    color: #fdf8ee;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; font-weight: 700;
  }
  .sim-home-title {
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 700;
    color: var(--sim-tx-1);
    letter-spacing: -0.01em;
  }
  .sim-home-desc { font-size: 11.5px; color: var(--sim-tx-2); line-height: 1.6; max-width: 400px; }
  .sim-home-input {
    width: 100%;
    max-width: 430px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 16px;
  }
  .sim-home-ai {
    font-size: 10.5px;
    color: var(--sim-accent-deep);
    background: rgba(60, 90, 74, 0.12);
    border: 1px solid rgba(60, 90, 74, 0.2);
    border-radius: 999px;
    padding: 3px 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .sim-home-input .sim-input { flex: 1; }
  .sim-home-model {
    font-size: 10px;
    color: var(--sim-tx-2);
    border: 1px solid var(--sim-line);
    border-radius: 6px;
    padding: 3px 7px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .sim-home-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .sim-chip {
    font-size: 11px;
    color: var(--sim-tx-1);
    border: 1px solid var(--sim-line);
    background: rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    padding: 5px 14px;
  }
  /* 首页任务示例列表（真实文案） */
  .sim-home-tasks {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 100%;
    max-width: 430px;
    margin-top: 4px;
  }
  .sim-home-task {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 10.5px;
    color: var(--sim-tx-1);
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(38, 34, 28, 0.08);
    border-radius: 8px;
    padding: 7px 11px;
    text-align: left;
  }
  .sim-home-task .arrow { color: var(--sim-warn); font-size: 11px; flex-shrink: 0; }

  /* ============================ v2：概览 / 市场 / 会话 / 供应商 / 设置 ============================ */
  .page-scroll{flex:1;min-height:0;overflow-y:auto;padding:0 var(--sp6) var(--sp6)}
  .empty-hint{color:var(--text-tertiary);padding:40px 0;text-align:center;font-size:12px}

  /* 概览 */
  .home-scroll{flex:1;min-height:0;overflow-y:auto;padding:0 var(--sp6) var(--sp6)}
  .home-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}
  .stat-card{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-md);padding:12px 14px}
  .stat-card .k{font-size:11px;color:var(--text-tertiary);margin-bottom:6px}
  .stat-card .v{font-size:15px;font-weight:600;color:var(--text-primary)}
  .stat-card .s{font-size:11px;color:var(--text-secondary);margin-top:3px}
  .stat-card.ok .v{color:var(--success)} .stat-card.bad .v{color:var(--danger)} .stat-card.warn .v{color:var(--warning)}
  .home-sec-title{font-size:11px;font-weight:500;color:var(--text-tertiary);margin:18px 0 8px;letter-spacing:.02em}
  .home-quick{display:flex;flex-wrap:wrap;gap:8px}
  .card{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-md);padding:12px 14px}

  /* 脚本市场 */
  .market-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px}
  .mk-card{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-md);padding:14px;display:flex;flex-direction:column;gap:8px}
  .mk-head{display:flex;align-items:center;gap:8px}
  .mk-ico{width:30px;height:30px;border-radius:8px;background:var(--accent-soft);color:var(--accent-text);display:flex;align-items:center;justify-content:center;font-size:14px;flex:0 0 30px}
  .mk-name{font-weight:600;font-size:12.5px}
  .mk-ver{margin-left:auto;font-size:10.5px;color:var(--text-tertiary);font-family:var(--mono)}
  .mk-desc{font-size:11.5px;color:var(--text-secondary);line-height:1.55;flex:1}
  .mk-foot{display:flex;align-items:center;gap:8px}
  .mk-author{font-size:10.5px;color:var(--text-tertiary)}
  .mk-foot .btn{margin-left:auto;padding:4px 12px}
  .mk-installed{font-size:10.5px;color:var(--success)}

  /* 插件管理 */
  .plugins-zone{border:1px dashed var(--border-strong);border-radius:var(--r-md);padding:18px;text-align:center;color:var(--text-tertiary);font-size:12px;background:var(--bg-surface);transition:all .12s;margin-top:2px}
  .plugins-zone.dragover{border-color:var(--accent);background:var(--accent-soft);color:var(--accent-text)}
  .plugins-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px;margin-top:10px}
  .pk-card{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-md);padding:14px;display:flex;flex-direction:column;gap:8px}
  .pk-card.pk-off{opacity:.45;filter:grayscale(.6)}
  .plugin-master{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:12px;color:var(--text-secondary);cursor:pointer;width:fit-content}
  .plugin-master .switch{transform:scale(.8);transform-origin:left center}
  .pk-head{display:flex;align-items:center;gap:8px}
  .pk-name{font-size:12.5px;font-weight:600;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pk-ver{font-size:10.5px;color:var(--text-tertiary);font-family:var(--mono)}
  .pk-dead{font-size:10px;color:var(--danger);border:1px solid var(--danger);border-radius:var(--r-xs);padding:1px 5px}
  .pk-desc{font-size:11.5px;color:var(--text-secondary);line-height:1.55}
  .pk-badges{display:flex;gap:6px;flex-wrap:wrap}
  .pk-badge{font-size:10px;font-family:var(--mono);color:var(--accent-text);background:var(--accent-soft);border-radius:var(--r-xs);padding:1px 6px}
  .pk-badge-a{font-size:10px;font-family:var(--mono);color:var(--success);border:1px solid var(--success);border-radius:var(--r-xs);padding:1px 6px}
  .pk-row{display:flex;align-items:center;gap:8px;font-size:11px}
  .pk-target{width:56px;color:var(--text-tertiary);font-family:var(--mono)}
  .pk-wired{font-size:10.5px;color:var(--text-tertiary);margin-left:auto}
  .pk-wired.ok{color:var(--success)}
  .pk-foot{display:flex;align-items:center;gap:8px;margin-top:2px}
  .pk-store{font-size:10.5px;color:var(--text-tertiary)}
  .pk-foot .btn{margin-left:auto;padding:4px 12px}
  .pp-radio{display:inline-flex;align-items:center;gap:6px;font-size:12px;cursor:pointer;color:var(--text-primary)}
  .pp-radio input{accent-color:var(--accent)}
  .plug-input{box-sizing:border-box;background:var(--bg-input,#fff);color:var(--text-primary);border:1px solid var(--border-default);border-radius:var(--r-sm);padding:6px 10px;font-size:12px;font-family:var(--mono)}
  .plug-input:focus{outline:none;border-color:var(--accent)}

  /* 会话 / 供应商 表 */
  .tbl{width:100%;border-collapse:collapse;background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-md);overflow:hidden}
  .tbl th{font-size:11px;color:var(--text-tertiary);font-weight:500;text-align:left;padding:8px 12px;border-bottom:1px solid var(--border-default);background:var(--bg-raised)}
  .tbl td{font-size:12px;padding:8px 12px;border-bottom:1px solid var(--border-subtle);color:var(--text-primary)}
  .tbl tr:last-child td{border-bottom:none}
  .tbl tr:hover td{background:var(--bg-hover)}
  .tbl .mono{font-family:var(--mono);font-size:11px;color:var(--text-secondary)}
  .row-actions{display:flex;gap:6px;justify-content:flex-end}
  .row-actions .btn{padding:3px 10px;font-size:11px}
  .prov-block{margin-bottom:12px}

  /* 设置表单 */
  .settings-form{max-width:640px}
  .set-row{display:flex;align-items:flex-start;gap:16px;padding:12px 0;border-bottom:1px solid var(--border-subtle)}
  .set-row:last-child{border-bottom:none}
  .set-label{flex:0 0 190px;font-size:12px;font-weight:500;padding-top:2px}
  .set-label .d{display:block;font-weight:400;font-size:11px;color:var(--text-tertiary);margin-top:2px}
  .set-ctrl{flex:1}
  .set-ctrl input[type=text],.set-ctrl input[type=number]{width:100%;max-width:320px;background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-sm);padding:6px 9px;font-size:12px}
  .set-ctrl input:focus{outline:none;border-color:var(--accent)}
  .set-ctrl select{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-sm);padding:6px 9px;font-size:12px}
  .set-check{display:flex;align-items:center;gap:8px;font-size:12px}

  /* === 分区：令牌用量（内置版 token-usage 仪表盘）=== */
  /* 令牌用量页：浅色 Apple 风格（参照原插件 token-usage UI），页面级变量覆盖，不影响其它页面 */
  #view-tu{
    --bg-surface:#f5f5f7; --bg-raised:#ffffff; --border-default:#e5e5ea; --border-subtle:#ebebf0;
    --border-strong:#d1d1d6; --text-primary:#1d1d1f; --text-secondary:#86868b; --text-tertiary:#a1a1a6;
    --accent:#1d1d1f; --accent-soft:rgba(0,0,0,.07); --accent-text:#ffffff;
    --r-md:10px; --r-sm:8px;
    --tu-h1:#e3f1e3; --tu-h2:#c0e3c0; --tu-h3:#8fce8f; --tu-h4:#57b457; --tu-h5:#2ea043;
  }
  #view-tu .tu-range-btn{padding:5px 11px;font-size:13px;line-height:1;border-radius:6px;cursor:pointer;border:1px solid var(--border-default);background:var(--bg-raised);color:var(--text-secondary)}
  #view-tu .tu-range-btn.on{background:var(--accent);border-color:var(--accent);color:#ffffff;font-weight:600}
  #view-tu .tu-info{font-size:12px;color:var(--text-tertiary);margin-left:4px;cursor:help}
  #view-tu .tu-grid{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:12px}
  #view-tu .tu-metric{flex:1 1 150px;min-width:140px;background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-md);padding:10px 12px}
  #view-tu .tu-metric .v{font-size:20px;font-weight:700;color:var(--text-primary);font-variant-numeric:tabular-nums}
  #view-tu .tu-metric .c{font-size:11px;color:var(--text-tertiary);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #view-tu .tu-card{background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-md);padding:10px 12px;margin-bottom:12px}
  #view-tu .tu-card h3{font-size:12px;font-weight:700;color:var(--text-primary);margin-bottom:8px;display:flex;align-items:center;gap:8px}
  #view-tu .tu-seg{display:inline-flex;background:var(--bg-raised);border:1px solid var(--border-default);border-radius:var(--r-sm);overflow:hidden;font-size:11px;flex:none}
  #view-tu .tu-seg button{border:0;background:transparent;color:var(--text-tertiary);padding:3px 9px;cursor:pointer}
  #view-tu .tu-seg button.on{background:var(--accent-soft);color:var(--accent-text);font-weight:600}
  #view-tu .tu-heat{display:flex;gap:2px;overflow-x:auto;padding:2px}
  #view-tu .tu-heat-col{display:flex;flex-direction:column;gap:2px;flex:none}
  #view-tu .tu-cell{width:9px;height:9px;border-radius:2px;background:var(--bg-raised);border:1px solid var(--border-subtle);flex:none}
  #view-tu .tu-cell.tu-1{background:var(--tu-h1);border-color:transparent}
  #view-tu .tu-cell.tu-2{background:var(--tu-h2);border-color:transparent}
  #view-tu .tu-cell.tu-3{background:var(--tu-h3);border-color:transparent}
  #view-tu .tu-cell.tu-4{background:var(--tu-h4);border-color:transparent}
  #view-tu .tu-cell.tu-5{background:var(--tu-h5);border-color:transparent}
  #view-tu .tu-months{display:flex;gap:2px;font-size:9px;color:var(--text-tertiary);margin-top:2px;overflow-x:auto}
  #view-tu .tu-mono{font-family:var(--mono);font-size:11px;color:var(--text-secondary);font-variant-numeric:tabular-nums}
  #view-tu .tu-note{font-size:11px;color:var(--text-tertiary);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  #view-tu .tu-warm{display:flex;align-items:center;gap:8px;padding:14px;background:var(--bg-surface);border:1px solid var(--border-default);border-radius:var(--r-md);color:var(--text-secondary);font-size:12px}
  #view-tu .tu-spin{width:14px;height:14px;border:2px solid var(--border-strong);border-top-color:var(--accent);border-radius:50%;animation:tu-rot .8s linear infinite;flex:none}
  @keyframes tu-rot{to{transform:rotate(360deg)}}
  #view-tu .tu-legend{display:flex;flex-wrap:wrap;gap:4px 12px;font-size:11px;color:var(--text-secondary);margin-top:6px}
  #view-tu .tu-dot{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:4px;vertical-align:baseline}
  #view-tu .tu-donut{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  #view-tu .tu-empty{color:var(--text-tertiary);font-size:12px;padding:16px 0}
  /* 启动加载过渡遮罩：应用启动即预取全部数据，加载期间全屏过渡动画 */
  #boot-mask{position:fixed;inset:0;z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:var(--bg-app);transition:opacity .35s ease}
  #boot-mask.done{opacity:0;pointer-events:none}
  #boot-mask .boot-spin{width:32px;height:32px;border:3px solid var(--border-strong);border-top-color:var(--accent);border-radius:50%;animation:tu-rot .9s linear infinite}
  #boot-mask .boot-title{font-size:15px;font-weight:700;color:var(--text-primary)}
  #boot-mask .boot-sub{font-size:12px;color:var(--text-tertiary)}

</style>
</head>
<body data-page-node-id="01DK7ZbuyggrY9IMx9lFXZ">

<div id="boot-mask" data-page-node-id="bootmask0">
  <span class="boot-spin"></span>
  <div class="boot-title">DSH++ 启动中…</div>
  <div class="boot-sub">正在汇总会话语料与 Token 用量，请稍候</div>
</div>

<div class="app" data-page-node-id="ftE1SwnSuq09kq7HMYY3HQ">
  <!-- ============================ 顶栏 ============================ -->
  <header class="header" data-page-node-id="EkkPqyMAiu0Kfv971Y2DO3">
    <div class="brand" data-page-node-id="WWIzRS3g4LEao8RfsxEvCf">
      <div class="brand-mark" data-page-node-id="xtQRFWtBsfdxbeli52slpr">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" data-page-node-id="ywZxW1US4ZH2S8IoLrNzd6">
          <path d="M4 6h16M12 6v14" data-page-node-id="FxsinREDSr3iMbYndLWUec"/><circle cx="12" cy="4" r="2" fill="currentColor" stroke="none" data-page-node-id="bOSsAKgkpuHIHwIwC3xgqq"/>
        </svg>
      </div>
      <div class="brand-text" data-page-node-id="QOKykB4OD3zu1kWZ7PKOl1"><h1 data-page-node-id="3ikwCUMr0i7xDIeEQKWFv8">DSH++</h1></div>
    </div>

    <div class="spacer" data-page-node-id="mR5SagXgwa01SRFEfmmbMa"></div>

    <div class="search-wrap" data-page-node-id="4fD8nARpG65uRwRftTGZFN">
      <svg class="s-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" data-page-node-id="LDfPFc4g0hkjGJcBIulLGH">
        <circle cx="10.5" cy="10.5" r="6.5" data-page-node-id="cJkvJQ3hV80UEZbWkNtLQa"/><path d="M15.5 15.5L20 20" data-page-node-id="ziVHEZL0TWKubrOJ9F3i2w"/>
      </svg>
      <input type="search" id="theme-search" class="search-box" placeholder="搜索主题、模块或参数" oninput="filterThemes(this.value)" data-page-node-id="awiasNRMIH6aQwxkQu03Lt">
      <span class="s-kbd" data-page-node-id="NQCf21OsmVeQUsBHcPiuRk">Ctrl K</span>
    </div>

    <div class="health-badge" id="health-badge" onclick="runRepair()" title="点击执行注入自检与修复" data-page-node-id="xADuw6CFHhq6LXE5YltnA0">
      <span class="health-dot" data-page-node-id="wPElrTyFo0Zq4WY6IwMoc9"></span>
      <span class="health-text" id="health-text" data-page-node-id="HqUFK7FFF4swBPff1Clc5m">检查中…</span>
    </div>

    <button class="btn btn-solid" onclick="appQuit()" id="app-quit-btn" title="退出 DSH++ 后台进程（释放 dist\DSH++.exe，便于重新构建）"
            style="margin-left:14px;background:var(--danger);border-color:var(--danger);padding:5px 14px">退出</button>

    <div class="seg" data-page-node-id="hSSEt0oX6cFyB2S9cD99QS">
      <button id="mode-light" onclick="setMode('light')" class="on" data-page-node-id="4zGnoAuphEoIDe0dFyIGPx">浅色</button>
      <button id="mode-dark" onclick="setMode('dark')" data-page-node-id="lxCOOsJ8XIFBsUKBXqHQD2">深色</button>
    </div>
  </header>
  <div class="hairline" data-page-node-id="Tqgl4MQ0NCq5VyQlUeA8mm"></div>

  <!-- 重启提示条 -->
  <div class="restart-bar" id="restart-bar" data-page-node-id="IfVDWbQEBWVaC5Z0vZoM71">
    <div class="rb-left" data-page-node-id="1iTZd9b6yfgVSmSzUlN9b1">
      <span class="health-dot" data-page-node-id="FNcVabQhG2NcZWjqCAGt6d"></span>
      <span id="restart-text" data-page-node-id="hhzMdGR3T7PqF9vUDPy3hn">已应用，DeepSeek Harness 正在运行，重启后生效。</span>
    </div>
    <div class="rb-actions" data-page-node-id="lcgltyUWs5Gq14yrK29zZH">
      <button class="btn btn-ghost" onclick="dismissRestart()" data-page-node-id="XchfkPtdAEJ0bwlNnmn6Zw">稍后</button>
      <button class="btn btn-solid" onclick="confirmRestart()" data-page-node-id="Q9KhAdwXT6zfA4BCl6WG8J">重启 DeepSeek Harness</button>
    </div>
  </div>

  <!-- ============================ 主体 ============================ -->
  <div class="body" data-page-node-id="ov53JAYhH1aZlhqOwesXd8">

    <!-- ---------- 左栏 ---------- -->
    <nav class="rail" data-page-node-id="X7ArqyQpa6DSJpxBZMa5yO">
      <div class="rail-group" data-page-node-id="DVfwYBMBTMqGGRQ52vfDEI">工作区</div>

      <div class="nav on" id="nav-home" onclick="switchView('home')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="5" rx="1.5"/><rect x="13" y="10" width="8" height="11" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/>
        </svg>
        <span class="nav-label">概览</span>
      </div>

      <div class="nav" id="nav-themes" onclick="switchView('themes')" data-page-node-id="uaS8mjtliOCWJNdVL4mzfg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" data-page-node-id="hb4cDDpXdW6tedLpDRwckI">
          <rect x="3" y="4" width="18" height="16" rx="2" data-page-node-id="Giry6S3XsYdFdRl2S0FKqG"/><circle cx="8.5" cy="9" r="1.6" data-page-node-id="ydq5ZLHFKKNIgICkXFDiHT"/><path d="M4 17l5-5 3.5 3.5L16 12l4 4" data-page-node-id="vnOmaW7mEV9rOLDnkGwbuf"/>
        </svg>
        <span class="nav-label" data-page-node-id="eMs38aY2iyd063FfadiJaE">动态壁纸</span>
        <span class="nav-count" id="nav-count-themes" data-page-node-id="x8M3wTbGaePvyOGVWTN3Ii">—</span>
      </div>

      <div class="nav" id="nav-sessions" onclick="switchView('sessions')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8M8 13h5"/>
        </svg>
        <span class="nav-label">会话管理</span>
        <span class="nav-count" id="nav-count-sessions">—</span>
      </div>

      <div class="nav" id="nav-prov" onclick="switchView('prov')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="12" cy="5.5" rx="8" ry="2.8"/><path d="M4 5.5v13c0 1.5 3.6 2.8 8 2.8s8-1.3 8-2.8v-13"/><path d="M4 12c0 1.5 3.6 2.8 8 2.8s8-1.3 8-2.8"/>
        </svg>
        <span class="nav-label">供应商配置</span>
      </div>

      <div class="nav" id="nav-models" onclick="switchView('models')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>
        </svg>
        <span class="nav-label">模型管理</span>
      </div>

      <div class="nav" id="nav-tu" onclick="switchView('tu')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18"/><path d="M7 15v2M11 10v7M15 6v11M19 9v8"/>
        </svg>
        <span class="nav-label">令牌用量</span>
      </div>

      <div class="rail-divider" data-page-node-id="MiIMlR2ZDPnl85zxUhlSqM"><div class="ln" data-page-node-id="HsA06Rtp8MfpKZyRruw8AY"></div></div>
      <div class="rail-group" style="padding-top:2px" data-page-node-id="X77I12oiLoji7jYcagAYKo">扩展</div>

      <div class="nav" id="nav-enh" onclick="switchView('enh')" data-page-node-id="IPdASuUK6qGHrJXjkD3uUi">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" data-page-node-id="MzA49RfyXJwO6GCBtGCWnr">
          <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18" data-page-node-id="t5aQd8xLg4mBkPgjuD1poZ"/><circle cx="12" cy="12" r="3" data-page-node-id="08GhGjYyiU1mYFW56TCc80"/>
        </svg>
        <span class="nav-label" data-page-node-id="0Ed3Td9Yg7rIKGQlti9mcF">DSH 增强</span>
        <span class="nav-count" id="nav-count-enh" data-page-node-id="VOm4G6z70bjS2QN5ZArIEO">—</span>
      </div>

      <div class="nav" id="nav-plugins" onclick="switchView('plugins')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M9 7H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3"/><rect x="9" y="7" width="6" height="4" rx="1"/>
        </svg>
        <span class="nav-label">插件管理</span>
        <span class="nav-count" id="nav-count-plugins">—</span>
      </div>

      <div class="nav" id="nav-market" onclick="switchView('market')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 6h15l-1.5 8.5a2 2 0 0 1-2 1.5H9a2 2 0 0 1-2-1.7L5.2 4.7A2 2 0 0 0 3.2 3H2"/><circle cx="9.5" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/>
        </svg>
        <span class="nav-label">脚本市场</span>
        <span class="nav-count" id="nav-count-market">—</span>
      </div>

      <div class="rail-divider"><div class="ln"></div></div>
      <div class="rail-group" style="padding-top:2px">系统</div>

      <div class="nav" id="nav-diag" onclick="switchView('diag')" data-page-node-id="8ssKbR3RHJ5lqYJkixRtIo">
